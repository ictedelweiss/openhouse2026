{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openhouse2026",
	"compatibility_date": "2026-07-30",
	"main": ".open-next/worker.js",
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "openhouse_db",
			"database_id": "2a2e1f19-7aec-477e-8835-eb7b5a1896f1"
		}
	],
	"r2_buckets": [
		{
			"binding": "UPLOAD_BUCKET",
			"bucket_name": "openhouse-uploads"
		}
	],
	"vars": {
		"MS_CLIENT_ID": "5cf8de04-6ded-4d38-9fb2-25ffff992eb7",
		"MS_TENANT_ID": "6d9ec31b-9635-42f8-a9cc-081a25c4efb5",
		"MS_CLIENT_SECRET": "",
		"MS_SENDER_EMAIL": "oh@edelweiss.sch.id"
	}
}